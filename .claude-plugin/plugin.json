{
  "name": "taskpilot",
  "description": "A local service exposing an HTTP API to spawn and manage long-running autonomous Claude Code agents",
  "version": "0.13.0",
  "author": {
    "name": "NOV LLC",
    "url": "https://github.com/softwaresoftware-dev"
  },
  "repository": "https://github.com/softwaresoftware-dev/taskpilot",
  "keywords": [
    "agent",
    "autonomous",
    "background",
    "task",
    "tmux",
    "channel",
    "daemon"
  ],
  "mcpServers": {
    "taskpilot": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "server.py"
      ],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
